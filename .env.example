# ─────────────────────────────────────────────────────────────
# PrivacyOS environment configuration
# Copy to `.env.local` and fill in. Never commit real secrets.
# ─────────────────────────────────────────────────────────────

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI providers for the agent orchestration layer.
# If neither is set, agents run with the deterministic mock provider
# so the platform is fully functional in development without keys.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Which provider the orchestrator prefers: "anthropic" | "openai" | "mock"
PRIVACYOS_LLM_PROVIDER=mock

# Discovery connectors.
# HaveIBeenPwned API key for the breach connector. If unset, the connector uses
# a deterministic offline simulator so discovery is runnable without a key.
HIBP_API_KEY=
