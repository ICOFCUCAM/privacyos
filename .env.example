# ─────────────────────────────────────────────────────────────
# PrivacyOS environment configuration
# Copy to `.env.local` and fill in. Never commit real secrets.
# ─────────────────────────────────────────────────────────────

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin allowlist — comma-separated emails that get full access to every suite
# and the entire agent fleet, regardless of subscription.
PRIVACYOS_ADMIN_EMAILS=

# AI providers for the agent orchestration layer.
# If neither key is set, agents run with the deterministic mock provider
# so the platform is fully functional in development without keys.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Which provider the orchestrator prefers: "anthropic" | "openai" | "mock".
# A misconfigured value still auto-detects from whichever key is present.
PRIVACYOS_LLM_PROVIDER=mock

# Optional model overrides — upgrade models without a code change.
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_MODEL=gpt-4o

# Public base URL of the app, used to build OAuth/SSO redirect URLs. If unset,
# the request host is used. Set this in production (e.g. https://app.example.com).
NEXT_PUBLIC_SITE_URL=

# Discovery connectors.
# HaveIBeenPwned API key for the breach connector. If unset, the connector uses
# a deterministic offline simulator so discovery is runnable without a key.
HIBP_API_KEY=

# SerpApi key — powers three discovery connectors:
#   • reverse-image / impersonation (Google Lens) — finds unauthorized use of a
#     subject's photo; runs live only for subjects with a photo on file.
#   • search autocomplete — flags damaging name suggestions ("<name> scam/fraud").
#   • multi-engine search — Bing / DuckDuckGo / Yandex broker + search exposure.
# Unset = deterministic offline simulators (autocomplete, reverse-image) / the
# demo search layer (multi-engine), so discovery is fully runnable without a key.
SERPAPI_API_KEY=

# ReputationOS — live search rankings (SEO tab).
# Provider precedence: Olostep → Serper.dev → deterministic model. Results are
# cached per subject for 12h (serp_cache table) to save provider credits.
# (Azure Bing Search was retired 2025-08-11 and is intentionally unsupported.)
# Olostep web-data API — real Google SERP via the @olostep/google-search parser.
OLOSTEP_API_KEY=
# Serper.dev (Google) — used when no Olostep key is set.
SERPER_API_KEY=
# (Podcast discovery on the Intelligence tab uses the keyless iTunes Search API.)

# ReputationOS — Media tab journalist contacts (optional).
# Hunter.io key enriches outlets discovered from coverage with real editorial
# emails (domain-search), cached 30d (contact_cache table). Unset = journalists
# stay outlet-desk level with no emails.
HUNTER_API_KEY=

# ExecutiveOS — Residence tab property data (optional).
# An ATTOM-style property-data key independently sources the residence checks
# (property records, map/satellite visibility, active listings), cached 30d
# (residence_cache table). Unset = the four checks are inferred from address
# exposures (the page shows an "Inferred" badge instead of "Property data").
PROPERTY_DATA_API_KEY=

# Financial Exposure — Credit monitoring (optional).
# A contracted credit-bureau/aggregator key (Equifax/Experian/TransUnion direct,
# or Array/Plaid/MX/Spinwheel) activates live credit monitoring — new-account,
# inquiry, derogatory, score-drop and public-record alerts. Requires an FCRA-
# compliant data agreement, SSN handling and explicit consumer consent. Unset =
# a deterministic, PII-free demo profile (the page shows a "Demo" badge).
CREDIT_API_KEY=

# Scheduler (always-on monitoring via /api/cron).
# Shared secret required to trigger the scheduled protection cycle. Senders must
# send `Authorization: Bearer <CRON_SECRET>`. Vercel Cron sets this automatically
# when CRON_SECRET is configured. Leave blank to disable the guard (dev only).
CRON_SECRET=
# Base URL of the deployed app, used by the Supabase Edge Function trigger.
APP_URL=

# Billing (Stripe). Unset = billing disabled; the app builds/runs without it.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Per-plan Stripe Price ids, named STRIPE_PRICE_<PLAN_ID upper, dashes→underscores>.
# Each plan has a monthly price and an optional _ANNUAL price. The activation
# flow (/start) defaults to the annual price and falls back to monthly when the
# _ANNUAL one is unset. `npm run stripe:setup -- --annual` prints all of these.
# CRON note above applies to /api/cron, not billing.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_PLUS=
STRIPE_PRICE_PLUS_ANNUAL=
STRIPE_PRICE_PREMIUM=
STRIPE_PRICE_PREMIUM_ANNUAL=
STRIPE_PRICE_FAMILY=
STRIPE_PRICE_FAMILY_ANNUAL=
STRIPE_PRICE_REP_PROFESSIONAL=
STRIPE_PRICE_REP_PROFESSIONAL_ANNUAL=
STRIPE_PRICE_REP_CREATOR=
STRIPE_PRICE_REP_CREATOR_ANNUAL=
STRIPE_PRICE_REP_PUBLIC_FIGURE=
STRIPE_PRICE_REP_PUBLIC_FIGURE_ANNUAL=
STRIPE_PRICE_EXEC_ESSENTIAL=
STRIPE_PRICE_EXEC_ESSENTIAL_ANNUAL=
STRIPE_PRICE_EXEC_PRO=
STRIPE_PRICE_EXEC_PRO_ANNUAL=
STRIPE_PRICE_EXEC_ELITE=
STRIPE_PRICE_EXEC_ELITE_ANNUAL=
STRIPE_PRICE_BIZ_STARTUP=
STRIPE_PRICE_BIZ_STARTUP_ANNUAL=
STRIPE_PRICE_BIZ_GROWTH=
STRIPE_PRICE_BIZ_GROWTH_ANNUAL=
STRIPE_PRICE_BIZ_ENTERPRISE=
STRIPE_PRICE_BIZ_ENTERPRISE_ANNUAL=
STRIPE_PRICE_BIZ_ENTERPRISE_PLUS=
STRIPE_PRICE_BIZ_ENTERPRISE_PLUS_ANNUAL=
STRIPE_PRICE_AI_PACK=
STRIPE_PRICE_AI_PACK_ANNUAL=
STRIPE_PRICE_AI_PRO=
STRIPE_PRICE_AI_PRO_ANNUAL=
