# ─────────────────────────────────────────────────────────────
# PrivacyOS environment configuration
# Copy to `.env.local` and fill in. Never commit real secrets.
# ─────────────────────────────────────────────────────────────

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin allowlist — comma-separated emails that get full access to every suite
# and the entire agent fleet, regardless of subscription.
PRIVACYOS_ADMIN_EMAILS=

# AI providers for the agent orchestration layer.
# If neither key is set, agents run with the deterministic mock provider
# so the platform is fully functional in development without keys.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Which provider the orchestrator prefers: "anthropic" | "openai" | "mock".
# A misconfigured value still auto-detects from whichever key is present.
PRIVACYOS_LLM_PROVIDER=mock

# Optional model overrides — upgrade models without a code change.
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_MODEL=gpt-4o

# Public base URL of the app, used to build OAuth/SSO redirect URLs. If unset,
# the request host is used. Set this in production (e.g. https://app.example.com).
NEXT_PUBLIC_SITE_URL=

# Discovery connectors.
# HaveIBeenPwned API key for the breach connector. If unset, the connector uses
# a deterministic offline simulator so discovery is runnable without a key.
HIBP_API_KEY=

# ReputationOS — live search rankings (SEO tab).
# Provider precedence: Olostep → Bing (Azure) → Serper.dev → deterministic model.
# Olostep web-data API — real Google SERP via the @olostep/google-search parser.
OLOSTEP_API_KEY=
# Bing Web Search (Azure Cognitive Services): the Ocp-Apim-Subscription-Key.
# BING_SEARCH_ENDPOINT is optional (defaults to https://api.bing.microsoft.com).
BING_SEARCH_API_KEY=
BING_SEARCH_ENDPOINT=
# Serper.dev (Google) — used when no Olostep/Bing key is set.
SERPER_API_KEY=
# (Podcast discovery on the Intelligence tab uses the keyless iTunes Search API.)

# Scheduler (always-on monitoring via /api/cron).
# Shared secret required to trigger the scheduled protection cycle. Senders must
# send `Authorization: Bearer <CRON_SECRET>`. Vercel Cron sets this automatically
# when CRON_SECRET is configured. Leave blank to disable the guard (dev only).
CRON_SECRET=
# Base URL of the deployed app, used by the Supabase Edge Function trigger.
APP_URL=

# Billing (Stripe). Unset = billing disabled; the app builds/runs without it.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Per-plan Stripe Price ids, named STRIPE_PRICE_<PLAN_ID upper, dashes→underscores>.
# Examples:
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PLUS=
STRIPE_PRICE_PREMIUM=
STRIPE_PRICE_FAMILY=
STRIPE_PRICE_REP_PROFESSIONAL=
STRIPE_PRICE_REP_CREATOR=
STRIPE_PRICE_REP_PUBLIC_FIGURE=
STRIPE_PRICE_EXEC_ESSENTIAL=
STRIPE_PRICE_EXEC_PRO=
STRIPE_PRICE_EXEC_ELITE=
STRIPE_PRICE_BIZ_STARTUP=
STRIPE_PRICE_BIZ_GROWTH=
STRIPE_PRICE_BIZ_ENTERPRISE=
STRIPE_PRICE_BIZ_ENTERPRISE_PLUS=
STRIPE_PRICE_AI_PACK=
STRIPE_PRICE_AI_PRO=
